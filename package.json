{
  "name": "dsh-browser-bookmarks",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: bookmark manager for the sidebar browser with dropdown menu, custom reordering, editing and one-click navigation.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "author": "BuyukBang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuyukBang/dsh-browser-bookmarks.git"
  },
  "bugs": {
    "url": "https://github.com/BuyukBang/dsh-browser-bookmarks/issues"
  },
  "homepage": "https://github.com/BuyukBang/dsh-browser-bookmarks#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "browser",
    "bookmarks",
    "sidebar"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "license": "MIT"
}
